pipeline {
    agent any
    tools {
        allure 'Allure 2.35.1' // 与全局配置的 Allure 名称一致
    }
    triggers {
        cron('0 7 * * *') // 每天早上8点执行
    }
    environment {
        // Python 3.13 绝对路径
        PYTHON_313 = '/Library/Frameworks/Python.framework/Versions/3.13/bin/python3'
        PIP_313 = '/Library/Frameworks/Python.framework/Versions/3.13/bin/pip3'
        // 测试脚本和 Allure 结果目录路径
        TEST_SCRIPT = 'web_ui_framework/run.py'
        ALLURE_RESULTS = 'web_ui_framework/reports/allure-results'
        PIP_MIRROR = 'https://pypi.tuna.tsinghua.edu.cn/simple'
        // 核心：Allure 的 bin 目录绝对路径
        ALLURE_BIN = '/Users/caiwenkai/.jenkins/tools/ru.yandex.qatools.allure.jenkins.tools.AllureCommandlineInstallation/Allure_2.35.1/bin'
        PATH = "${env.PATH}:${ALLURE_BIN}" // 全局添加 Allure 命令路径
        // 邮件配置常量
        EMAIL_TO = 'caiwenkai0220@163.com' // 收件人邮箱
        EMAIL_FROM = 'caiwenkai0220@163.com' // 发件人邮箱（必须与SMTP认证用户名一致）
        // Allure报告访问链接（内网IP，手机同一Wi-Fi可访问）
        ALLURE_REPORT_URL = "${env.BUILD_URL}allure/"
    }
    stages {
        // 构建前清理历史文件（容错优化）
        stage('清理历史文件') {
            steps {
                echo '========== 清理 Allure 历史结果和报告 =========='
                sh '''
                    if [ -d "${ALLURE_RESULTS}" ]; then
                        rm -rf ${ALLURE_RESULTS}/*
                        echo "已清理 Allure 历史结果文件"
                    else
                        mkdir -p ${ALLURE_RESULTS}
                        echo "Allure 结果目录不存在，已创建"
                    fi
                '''
                sh 'rm -rf allure-report allure-report-offline.zip *.log .pytest_cache'
            }
        }

        stage('环境准备') {
            steps {
                echo '========== 配置 Python 3.13 环境 =========='
                sh "${PIP_313} install --upgrade pip -i ${PIP_MIRROR}"
                sh "${PIP_313} install pytest allure-pytest selenium pyyaml -i ${PIP_MIRROR}"

                echo '========== 检查环境版本 =========='
                sh "${PYTHON_313} --version"
                sh "${PYTHON_313} -m pytest --version"
                sh 'allure --version'
            }
        }

        stage('执行测试用例') {
            steps {
                echo '========== 开始执行 Python 测试脚本 =========='
                sh "${PYTHON_313} ${TEST_SCRIPT}"

                echo '========== 校验 Allure 结果文件 =========='
                sh '''
                    RESULT_COUNT=$(find ${ALLURE_RESULTS} -name "*.json" | wc -l)
                    echo "生成的 Allure 结果文件数量：${RESULT_COUNT}"
                    if [ ${RESULT_COUNT} -eq 0 ]; then
                        echo "错误：Allure 结果目录为空，测试脚本可能未执行或执行失败！"
                        exit 1
                    fi
                '''
            }
        }

        // 新增：打包 Allure 离线报告
        stage('打包 Allure 报告') {
            steps {
                echo '========== 打包 Allure 离线报告 =========='
                sh 'allure generate ${ALLURE_RESULTS} -o allure-report --clean' // 手动生成报告
                sh 'zip -r allure-report-offline.zip allure-report/' // 打包为 ZIP
                sh 'ls -l allure-report-offline.zip || echo "离线报告打包失败"'
            }
        }
    }

    post {
        always {
            echo '========== 生成 Jenkins 内置 Allure 报告 =========='
            allure(
                includeProperties: false,
                jdk: '',
                properties: [],
                reportBuildPolicy: 'ALWAYS',
                results: [[path: "${ALLURE_RESULTS}"]]
            )

            echo '========== 发送测试报告邮件 =========='
            emailext(
                subject: "【Jenkins测试报告】${env.JOB_NAME} - 构建#${env.BUILD_NUMBER} - ${currentBuild.currentResult}",
                body: """
                    <h3>测试任务执行结果：<font color="${currentBuild.currentResult == 'SUCCESS' ? 'green' : 'red'}">${currentBuild.currentResult}</font></h3>
                    <p>任务名称：${env.JOB_NAME}</p>
                    <p>构建编号：${env.BUILD_NUMBER}</p>
                    <p>构建时间：${new Date()}</p>
                    <p>👉 在线查看报告（同一Wi-Fi）：<a href="${ALLURE_REPORT_URL}">${ALLURE_REPORT_URL}</a></p>
                    <p>👉 离线查看：下载附件 allure-report-offline.zip，解压后用浏览器打开 index.html</p>
                    <p>任务详情链接：<a href="${env.BUILD_URL}">${env.BUILD_URL}</a></p>
                """,
                to: "${EMAIL_TO}",
                from: "${EMAIL_FROM}",
                mimeType: 'text/html',
                replyTo: "${EMAIL_FROM}",
                attachmentsPattern: 'allure-report-offline.zip'
            )
        }

        failure {
            echo '========== 测试执行失败，请检查用例或环境配置！=========='
        }
    }
}