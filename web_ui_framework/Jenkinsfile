// 声明式 Pipeline 语法（Jenkins 推荐）
pipeline {
    // 选择任意可用的 Jenkins 节点执行
    agent any

    // 引用全局工具配置的 Allure 命令行（名称必须与全局配置一致）
    tools {
        allure 'Allure 2.35.1'
    }

    // 定时执行规则：每天凌晨 2 点执行（可根据需求修改 Cron 表达式）
    triggers {
        cron('0 8 * * *')
    }

    // 构建环境变量（可自定义路径、依赖等）
    environment {
        // 测试脚本名称（与你的实际脚本一致）
        TEST_SCRIPT = 'web_ui_framework/run.py'
        // Allure 原始结果目录（与你 Python 代码中的路径一致）
        ALLURE_RESULTS = 'web_ui_framework/reports/allure-results'
        // Python 依赖安装镜像（国内源加速）
        PIP_MIRROR = 'https://pypi.tuna.tsinghua.edu.cn/simple'
    }

    // 流水线阶段
    stages {
        stage('环境准备') {
            steps {
                echo '========== 安装 Python 依赖包 =========='
                // 升级 pip 并安装依赖（allure-pytest 是生成 Allure 结果的核心）
                sh "python3 -m pip install --upgrade pip -i ${PIP_MIRROR}"
                sh "pip3 install pytest allure-pytest -i ${PIP_MIRROR}"

                // 检查环境是否正常
                echo '========== 检查环境版本 =========='
                sh 'python3 --version'
                sh 'pytest --version'
                sh 'allure --version'
            }
        }

        stage('执行测试用例') {
            steps {
                echo '========== 开始执行 Python 测试脚本 =========='
                // 执行测试脚本（若脚本需要虚拟环境，需先激活）
                sh "python3 ${TEST_SCRIPT}"

                // 验证 Allure 原始结果是否生成
                echo '========== 检查 Allure 原始结果目录 =========='
                sh "ls -l ${ALLURE_RESULTS}/ || echo 'Allure 结果目录为空，请检查测试脚本'"
            }
        }
    }

    // 构建后操作（无论成功/失败都执行）
    post {
        always {
            echo '========== 生成 Allure 测试报告 =========='
            // 基于 Allure 原始结果生成报告
            allure(
                includeProperties: false,
                jdk: '',
                properties: [],
                reportBuildPolicy: 'ALWAYS',
                results: [[path: "${ALLURE_RESULTS}"]]
            )
        }
        success {
            echo '========== 测试执行成功！=========='
        }
        failure {
            echo '========== 测试执行失败，请检查用例！=========='
        }
    }
}