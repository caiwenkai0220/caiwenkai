pipeline {
    agent any
    tools {
        allure 'Allure 2.35.1' // 与你全局配置的 Allure 版本一致
    }
    triggers {
        cron('0 7 * * *')
    }
    environment {
        // 核心：指定 Python 3.13 的绝对路径
        PYTHON_313 = '/Library/Frameworks/Python.framework/Versions/3.13/bin/python3'
        PIP_313 = '/Library/Frameworks/Python.framework/Versions/3.13/bin/pip3' // 对应版本的 pip
        // 测试脚本路径（根据你的项目结构调整）
        TEST_SCRIPT = 'web_ui_framework/run.py'
        // Allure 结果目录路径
        ALLURE_RESULTS = 'web_ui_framework/reports/allure-results'
        // 国内镜像源
        PIP_MIRROR = 'https://pypi.tuna.tsinghua.edu.cn/simple'
        // Python 3.13 的用户 bin 目录（后续调用 pytest 用）
        PYTHON_313_BIN = '/Library/Frameworks/Python.framework/Versions/3.13/bin'
    }
    stages {
        stage('环境准备') {
            steps {
                echo '========== 配置 Python 3.13 环境 =========='
                // 用 Python 3.13 的 pip 升级并安装依赖
                sh "${PIP_313} install --upgrade pip -i ${PIP_MIRROR}"
                sh "${PIP_313} install pytest allure-pytest -i ${PIP_MIRROR}"

                echo '========== 检查 Python 3.13 环境版本 =========='
                sh "${PYTHON_313} --version" // 验证是 3.13
                sh "${PYTHON_313} -m pytest --version" // 用模块方式调用 pytest，避免路径问题
                sh 'allure --version'
            }
        }
        stage('执行测试用例') {
            steps {
                echo '========== 开始执行 Python 测试脚本 =========='
                // 用 Python 3.13 执行测试脚本
                sh "${PYTHON_313} ${TEST_SCRIPT}"

                // 检查 Allure 结果目录是否生成
                sh "ls -l ${ALLURE_RESULTS}/ || echo 'Allure 结果目录为空，请检查测试脚本'"
            }
        }
    }
    post {
        always {
            echo '========== 生成 Allure 测试报告 =========='
            allure(
                includeProperties: false,
                jdk: '',
                properties: [],
                reportBuildPolicy: 'ALWAYS',
                results: [[path: "${ALLURE_RESULTS}"]]
            )
        }
        failure {
            echo '========== 测试执行失败，请检查用例！=========='
        }
    }
}